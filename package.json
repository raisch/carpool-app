{
	"name": "carpool-app",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "node --env-file=.env node_modules/vite/bin/vite.js dev",
		"build": "vite build",
		"preview": "node --env-file=.env node_modules/vite/bin/vite.js preview",
		"docker:clear": "docker compose down --volumes --rmi all --remove-orphans",
		"docker:build": "docker compose --env-file .env build --no-cache",
		"docker:logs": "docker compose logs -f",
		"docker:recreate": "pnpm run docker:clear && pnpm run docker:build",
		"docker:restart": "pnpm run docker:down && pnpm run docker:up && pnpm run docker:logs",
		"directus:migrate": "node --env-file=.env scripts/directus-migrate.mjs",
		"directus:test": "node --env-file=.env scripts/directus-migration-test.mjs",
		"directus:test:m3": "node --env-file=.env scripts/milestone3-live-test.mjs",
		"directus:test:m4": "node --env-file=.env scripts/milestone4-live-test.mjs",
		"directus:test:m5": "node --env-file=.env scripts/milestone5-live-test.mjs",
		"wordpress:contract:test": "node scripts/wordpress-contract-test.mjs",
		"wordpress:plugin:test": "node scripts/wordpress-plugin-static-test.mjs",
		"wordpress:integration:test": "node --env-file=.env scripts/wordpress-integration-test.mjs",
		"wordpress:release:test": "node scripts/wordpress-release-config-test.mjs",
		"wordpress:simulator": "node wordpress/simulator/server.mjs",
		"release:verify": "node --env-file=.env scripts/milestone6-release-test.mjs",
		"docker:up": "docker compose --env-file .env up -d",
		"docker:down": "docker compose down",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright install && playwright test"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^24",
		"@vitest/browser-playwright": "^4.1.8",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"playwright": "^1.60.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.0",
		"vitest": "^4.1.8",
		"vitest-browser-svelte": "^2.1.1"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
