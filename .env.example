# Local Directus and PostgreSQL development settings.
# Copy this file to .env before starting Docker Compose.
# Replace all credentials before using any non-local environment.

# PostgreSQL
# PostgreSQL database name used by Directus.
POSTGRES_DB=directus
# PostgreSQL username used by Directus.
POSTGRES_USER=directus
# PostgreSQL password used by Directus.
POSTGRES_PASSWORD=directus-local-password

# Directus
# Host port mapped to the Directus container.
DIRECTUS_PORT=8055
# Encryption key used by Directus. Use a unique value outside local development.
DIRECTUS_KEY=carpool-local-development-key-change-me
# Secret used by Directus for signing and encryption. Use a unique value outside local development.
DIRECTUS_SECRET=carpool-local-development-secret-change-me
# Email address for the initial Directus administrator.
DIRECTUS_ADMIN_EMAIL=admin@example.com
# Password for the initial Directus administrator.
DIRECTUS_ADMIN_PASSWORD=directus-local-admin-password
# Public URL where Directus is accessible.
DIRECTUS_PUBLIC_URL=http://localhost:8055
# Static token used by the SvelteKit server for Directus API access.
# Create one for the local server in the Directus admin UI.
DIRECTUS_TOKEN=

# URL used by the SvelteKit server when connecting to Directus.
DIRECTUS_URL=http://localhost:8055

# Local identity modes
#
# Choose one mode for local development. The CARPOOL_DEV_* adapter is only a
# convenience for testing role-specific UI; it does not implement login or
# sessions. Leave these commented out when testing WordPress provisioning.
# CARPOOL_DEV_USER_ID=9003
# CARPOOL_DEV_USER_NAME=Demo Rider
# CARPOOL_DEV_USER_ROLE=rider

# WordPress integration and provisioning boundary
#
# Keep disabled unless you are testing the real local WordPress simulator flow.
# For that flow, generate a development RSA key pair, set
# WORDPRESS_INTEGRATION_ENABLED=true, and point WORDPRESS_PUBLIC_KEY_PATH at
# the matching public key. The private key is configured only for the
# simulator below and must never be committed.
WORDPRESS_INTEGRATION_ENABLED=false
WORDPRESS_ISSUER=https://www.ligerbots.org
WORDPRESS_AUDIENCE=carpool-provisioning
WORDPRESS_KEY_ID=wordpress-development
WORDPRESS_PUBLIC_KEY=
# Optional JSON map of overlapping key IDs to PEM public keys during rotation.
WORDPRESS_PUBLIC_KEYS=
WORDPRESS_PUBLIC_KEY_PATH=
WORDPRESS_CLOCK_SKEW_SECONDS=5
WORDPRESS_LAUNCH_TTL_SECONDS=60
WORDPRESS_MAX_REQUEST_BYTES=16384
WORDPRESS_PROVISIONING_STORE=memory
WORDPRESS_PROVISIONING_URL=http://localhost:5173/api/integration/wordpress/provision
WORDPRESS_LAUNCH_PATH=/launch
WORDPRESS_LAUNCH_DESTINATION=/

# Carpool session boundary. Leave secure=false for local HTTP development;
# production should use HTTPS and the default secure=true behavior.
CARPOOL_SESSION_COOKIE=carpool_session
CARPOOL_SESSION_IDLE_TIMEOUT_SECONDS=1800
CARPOOL_SESSION_ABSOLUTE_TIMEOUT_SECONDS=28800
CARPOOL_SESSION_SECURE=false

# WordPress simulator
#
# The default mode is navigation-only and does not create a Carpool identity.
# To exercise the real local handoff, set the integration flag to true, use
# the private key corresponding to WORDPRESS_PUBLIC_KEY_PATH above, and start
# the simulator with the .env file loaded:
#
#   node --env-file=.env wordpress/simulator/server.mjs
#
# The pnpm wordpress:simulator script does not load .env by itself.
WORDPRESS_SIMULATOR_INTEGRATION_ENABLED=false
WORDPRESS_SIMULATOR_ISSUER=https://www.ligerbots.org
WORDPRESS_SIMULATOR_AUDIENCE=carpool-provisioning
WORDPRESS_SIMULATOR_PROVISIONING_URL=http://localhost:5173/api/integration/wordpress/provision
WORDPRESS_SIMULATOR_LAUNCH_URL=http://localhost:5173/launch
WORDPRESS_SIMULATOR_CARPOOL_URL=http://localhost:5173/
# URL shown by the Carpool navigation when returning to the local WordPress simulator.
WORDPRESS_SIMULATOR_URL=http://localhost:8080/
WORDPRESS_SIMULATOR_PRIVATE_KEY_PATH=
WORDPRESS_SIMULATOR_KEY_ID=wordpress-development
WORDPRESS_SIMULATOR_USER_PREFIX=
